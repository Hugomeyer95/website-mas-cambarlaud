# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne JAMAIS committer le fichier ".env" (il contient des secrets).

# Port du serveur
PORT=3000

# Mot de passe pour accéder au mode Edition et au tableau de bord admin.
# Choisissez quelque chose de solide — c'est la seule protection du site.
ADMIN_PASSWORD=change-moi

# Secret utilisé pour signer le cookie de session admin (chaîne aléatoire longue).
SESSION_SECRET=change-moi-aussi-une-longue-chaine-aleatoire

# Clé API Resend (https://resend.com) pour l'envoi des emails de réservation.
# Créez un compte, vérifiez un domaine d'envoi (ou utilisez le domaine de test
# onboarding@resend.dev fourni par Resend pour démarrer), puis générez une clé API.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse d'envoi des emails (doit appartenir à un domaine vérifié dans Resend,
# sinon utilisez temporairement "onboarding@resend.dev").
FROM_EMAIL="Mas Cambarlaud <onboarding@resend.dev>"

# Adresse qui reçoit les demandes de réservation à valider.
OWNER_EMAIL=hugomeyer95@gmail.com

# URL publique du site (utilisée dans les liens des emails). En local, laissez
# la valeur par défaut. Une fois déployé, remplacez par l'URL réelle.
PUBLIC_URL=http://localhost:3000
